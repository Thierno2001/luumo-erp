# ==============================================================================
# LUUMO — Configuration Infrastructure & Passerelles B2B (Copier vers .env)
# ==============================================================================

# --- 1. Base de données PostgreSQL 16 ---
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
LUUMO_DB_NAME=luumo

# --- 2. Cycle de vie automatique des modules au démarrage ---
# 1 = Initialise automatiquement la base "luumo" au premier lancement
LUUMO_AUTO_INIT=1
# 1 = Met à jour automatiquement luumo_base et luumo_api à chaque redémarrage
LUUMO_AUTO_UPGRADE=0

# --- 3. Passerelle Mobile Money & QR Code B2B (Guinée) ---
# Opérateur / Agrégateur par défaut : djomi | paycard | orange_money | mtn_momo
LUUMO_GATEWAY_PROVIDER=djomi
# Code marchand principal de l'entreprise
LUUMO_MERCHANT_ID=620145
# URL de l'API B2B de l'agrégateur (laisser vide en développement local)
LUUMO_GATEWAY_API_URL=
# Clé API secrète fournie par l'agrégateur B2B
LUUMO_API_SECRET=
# Clé secrète HMAC-SHA256 pour vérifier la signature X-Luumo-Signature des Webhooks
LUUMO_WEBHOOK_SECRET=luumo-default-hmac-secret-change-in-prod
# URL publique HTTPS de votre serveur Luumo (pour recevoir les Webhooks opérateurs)
LUUMO_PUBLIC_BASE_URL=
